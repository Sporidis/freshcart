{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug",
            "cwd": "${workspaceFolder}/freshcart_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "debug-live",
            "cwd": "${workspaceFolder}/freshcart_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=SERVER_URL=https://freshcart-nikos.duckdns.org/"
            ]
        },
        {
            "name": "freshcart_server",
            "cwd": "${workspaceFolder}/freshcart_server",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "docker_compose_up",
            "program": "bin/main.dart",
            "args": [
                "--apply-migrations"
            ]
        }
    ],
    "compounds": [
        {
            "name": "freshcart (full stack)",
            "configurations": [
                "freshcart_server",
                "debug"
            ],
            "presentation": {
                "order": 1
            }
        }
    ]
}
